{
    "djClassName": "org.dashjoin.function.Invoke",
    "ID": "weather",
    "expression": "$openJson('https://api.weather.gov/alerts/active?area=' & state).**.description",
    "comment": "Gets weather alerts for a given US state",
    "parameters": {
        "state": {
            "type": "string",
            "description": "Two letter state abbreviation (CA, NY, etc...)"
        }
    }
}